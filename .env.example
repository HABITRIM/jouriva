# ─────────────────────────────────────────────────────────────
# JOURIVA — environment configuration
# Copy to .env (never commit .env). Keep secrets out of source.
# ─────────────────────────────────────────────────────────────

# Canonical origin of the deployed site (no trailing slash).
# Used for canonical URLs, hreflang, sitemap, RSS, Open Graph.
# This is the ONLY place a domain may be configured (approved decision #3).
NEXT_PUBLIC_SITE_URL=https://www.jouriva.com

# ── Database (Phase 2) ────────────────────────────────────────
# PostgreSQL 15+ connection string. Migrations: npx prisma migrate deploy
DATABASE_URL=postgresql://user:password@localhost:5432/jouriva

# ── CMS auth (Phase 2) ───────────────────────────────────────
# HMAC key for session cookies + preview tokens. MUST be ≥ 32 random chars
# in production (openssl rand -hex 32). Rotating it invalidates all sessions.
SESSION_SECRET=change-me-to-32-plus-random-chars

# Bearer secret for the scheduled-publish cron endpoint (/api/cron/publish).
# Send as: Authorization: Bearer <CRON_SECRET>. Required for scheduling.
CRON_SECRET=change-me-too

# ── Media storage (Phase 2) ──────────────────────────────────
# Local driver: absolute directory where uploaded files are stored.
# In production, wire an object-storage driver (S3-compatible) in
# src/lib/storage.ts — the interface is already abstracted.
MEDIA_STORAGE_DIR=/var/lib/jouriva/uploads
MEDIA_MAX_MB=10

# ── Advertising placeholder toggle (Phase 1 visual demo only) ─
# Set to false to hide ad placeholders. Real ad provider keys (Phase 3+)
# must be server-side only and must NOT use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_ADS_DEMO=true

# ── Future phases (placeholders — do not fill in yet) ────────
# AD_PROVIDER_KEY=                   # Phase 3: advertising (server-side only)
# AFFILIATE_PROVIDER_DEEPA_KEY=      # Phase 3: affiliate provider (example)
# NEWSLETTER_PROVIDER_API_KEY=       # Phase 4: newsletter (server-side only)
